# Build output — everything the build produces lives under work/ and is
# reproducible from sources, so it never gets committed.
/work/

# Recorded-but-unverified source hashes (until promoted into config/versions.sh)
/config/versions.lock

# Editor / OS cruft
*.swp
*~
.DS_Store

# pkg/stam builds in place rather than under work/, so its output needs naming
# here. These were tracked until 2026-07-28: every kernel change committed a
# fresh set of object files, and the repo carried a stam.efi that had no fixed
# relation to the sources beside it — a binary a reader could reasonably take
# for the built one.
pkg/stam/*.o
pkg/stam/*.so
pkg/stam/*.elf
pkg/stam/*.efi
pkg/stam/*.img
pkg/stam/progs/*.o
pkg/stam/progs/*.elf
pkg/stam/progs/*.cpio
# Staging directories the initrd rules build with rm -rf and repopulate. The
# sources are pkg/stam/progs/*.c and progs/rc; these were tracked copies of
# what the build had produced at some past moment.
pkg/stam/progs/root/
pkg/stam/progs/sroot/
pkg/stam/progs/scriptroot/
