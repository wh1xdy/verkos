// stdin: the shell put this on our standard input
use "../../lib/text.sav";

entry fn main(io: Console) -> i32 {
    var buf: [128]u8;
    let n: i64 = io!read(buf[0..128]);
    if n <= 0 { return 1; }
    io!write("read: ");
    for i in 0..n { buf[i] = upper_case(buf[i]); }
    io!write(buf[0..n]);
    return 0;
}
