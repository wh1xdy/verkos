use "../../lib/say.sav";

// One line per number, so the expected output is a list.
fn say_line_num(out: Console, v: i64) {
    say_num(out, v);
    out!write("\n");
}

// Arithmetic, precedence and the narrow types staying narrow.
entry fn main(out: Console) -> i32 {
    say_line_num(out, 2 + 3 * 4);
    say_line_num(out, (2 + 3) * 4);
    say_line_num(out, 17 / 5);
    say_line_num(out, 17 % 5);
    say_line_num(out, 0 - 17 / 5);
    say_line_num(out, 1 << 10);
    say_line_num(out, 255 >> 4);
    say_line_num(out, 6 & 3);
    say_line_num(out, 6 | 3);
    say_line_num(out, 6 ^ 3);
    let a: u8 = 200;
    let b: u8 = 100;
    say_line_num(out, (a + b) as i64);       // wraps in u8, and says so
    if 3 < 4 && 5 >= 5 { out!write("comparisons hold\n"); }
    if 3 > 4 || 1 == 1 { out!write("or holds\n"); }
    return 0;
}
