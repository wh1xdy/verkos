use "../../lib/say.sav";

fn say_line_num(out: Console, v: i64) {
    say_num(out, v);
    out!write("\n");
}

fn fib(n: i64) -> f: i64
    needs n >= 0
    gives f >= 0
{
    if n < 2 { return n; }
    return fib(n - 1) + fib(n - 2);
}

fn sum6(a: i64, b: i64, c: i64, d: i64, e: i64, f: i64) -> total: i64
    gives total >= a
{
    return a + b + c + d + e + f;
}

entry fn main(out: Console) -> i32 {
    say_line_num(out, fib(20));
    say_line_num(out, sum6(1, 2, 3, 4, 5, 6));
    return 0;
}
