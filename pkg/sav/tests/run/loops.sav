fn show(out: Console, v: i64) {
    var buf: [24]u8;
    var i: i64 = 23;
    var x: i64 = v;
    if x == 0 { buf[i] = '0'; i = i - 1; }
    while x > 0 {
        buf[i] = ('0' as u8) + ((x % 10) as u8);
        x = x / 10;
        i = i - 1;
    }
    out!write(buf[i + 1..24]);
    out!write(" ");
}

entry fn main(out: Console) -> i32 {
    var sum: i64 = 0;
    for i in 0..10 { sum = sum + i; }
    show(out, sum);
    out!write("\n");

    var n: i64 = 0;
    while true {
        n = n + 1;
        if n == 3 { continue; }
        if n > 6 { break; }
        show(out, n);
    }
    out!write("\n");

    for i in 0..5 {
        for j in 0..5 {
            if j > i { break; }
            show(out, i * 10 + j);
        }
    }
    out!write("\n");
    return 0;
}
