use "../../lib/say.sav";

fn say_spaced(out: Console, v: i64) {
    say_num(out, v);
    out!write(" ");
}

entry fn main(out: Console) -> i32 {
    var sum: i64 = 0;
    for i in 0..10 { sum = sum + i; }
    say_spaced(out, sum);
    out!write("\n");

    var n: i64 = 0;
    while true {
        n = n + 1;
        if n == 3 { continue; }
        if n > 6 { break; }
        say_spaced(out, n);
    }
    out!write("\n");

    for i in 0..5 {
        for j in 0..5 {
            if j > i { break; }
            say_spaced(out, i * 10 + j);
        }
    }
    out!write("\n");
    return 0;
}
