// Structs, pointers into them, and a field that is a slice.
struct Point { x: i64, y: i64 }
struct Line { from: Point, to: Point, name: []u8 }

fn dx(l: *Line) -> d: i64
    gives d == l.to.x - l.from.x
{
    return l.to.x - l.from.x;
}

fn show(out: Console, v: i64) {
    var buf: [24]u8;
    var i: i64 = 23;
    var x: i64 = v;
    if x < 0 { out!write("-"); x = 0 - x; }
    if x == 0 { buf[i] = '0'; i = i - 1; }
    while x > 0 {
        buf[i] = ('0' as u8) + ((x % 10) as u8);
        x = x / 10;
        i = i - 1;
    }
    out!write(buf[i + 1..24]);
    out!write("\n");
}

entry fn main(out: Console) -> i32 {
    var l: Line;
    l.from.x = 3;
    l.from.y = 4;
    l.to.x = 10;
    l.to.y = 20;
    l.name = "diagonal";

    out!write(l.name);
    out!write("\n");
    show(out, dx(&l));
    show(out, l.to.y - l.from.y);
    show(out, size(Point));
    show(out, size(Line));

    let p: *Point = &l.to;
    p.x = 100;
    show(out, l.to.x);
    return 0;
}
