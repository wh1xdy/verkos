use "../../lib/say.sav";

fn say_line_num(out: Console, v: i64) {
    say_num(out, v);
    out!write("\n");
}

// Structs, pointers into them, and a field that is a slice.
struct Point { x: i64, y: i64 }
struct Line { from: Point, to: Point, name: []u8 }

fn dx(l: *Line) -> d: i64
    gives d == l.to.x - l.from.x
{
    return l.to.x - l.from.x;
}

entry fn main(out: Console) -> i32 {
    var l: Line;
    l.from.x = 3;
    l.from.y = 4;
    l.to.x = 10;
    l.to.y = 20;
    l.name = "diagonal";

    out!write(l.name);
    out!write("\n");
    say_line_num(out, dx(&l));
    say_line_num(out, l.to.y - l.from.y);
    say_line_num(out, size(Point));
    say_line_num(out, size(Line));

    let p: *Point = &l.to;
    p.x = 100;
    say_line_num(out, l.to.x);
    return 0;
}
