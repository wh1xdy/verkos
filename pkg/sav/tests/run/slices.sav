use "../../lib/say.sav";

fn say_line_num(out: Console, v: i64) {
    say_num(out, v);
    out!write("\n");
}

// Slices carry their length, and a slice of a slice is a slice.
fn count_letter(s: []u8, c: u8) -> n: i64
    needs c != 0
    gives n <= s.len
{
    var found: i64 = 0;
    for i in 0..s.len {
        if s[i] == c { found = found + 1; }
    }
    return found;
}

entry fn main(out: Console) -> i32 {
    let word: []u8 = "kvistarna";
    say_line_num(out, word.len);
    say_line_num(out, count_letter(word, 'a'));
    out!write(word[0..5]);
    out!write("\n");
    out!write(word[5..word.len]);
    out!write("\n");

    var buf: [8]u8;
    for i in 0..8 { buf[i] = ('A' as u8) + (i as u8); }
    out!write(buf[0..8]);
    out!write("\n");
    out!write(buf[2..5]);
    out!write("\n");
    return 0;
}
